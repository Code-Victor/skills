{
  "_note": "A fix video in the demo.json format. Run: node scripts/demo.mjs examples/quick-fix.demo.json (copy it out of the skill first, into a folder that survives a restart). Everything here is made up: the app, the ticket and the people.",
  "name": "quick-fix",
  "url": "http://localhost:3000",
  "capture": { "cursorScale": 1.25 },
  "takes": {
    "before": {
      "url": "/team",
      "duration": 8,
      "setup": "./reset-demo-data.sh",
      "steps": [
        { "wait": 1.2 },
        { "click": { "text": "Invite teammate" }, "dur": 0.8 },
        { "camera": "wide", "waitFor": { "selector": "[role=dialog]" }, "wait": 0.6 },
        { "click": { "selector": "input[aria-label='Email address']" }, "dur": 0.7 },
        { "type": "jordan.lee+demo@example.com", "cps": 22 },
        { "click": { "text": "Send invite" }, "dur": 0.7 },
        { "wait": 1.8 },
        { "move": { "x": 900, "y": 640 }, "dur": 0.8 }
      ]
    },
    "after": {
      "url": "/team",
      "duration": 8,
      "setup": "./reset-demo-data.sh",
      "steps": [
        { "wait": 1.2 },
        { "click": { "text": "Invite teammate" }, "dur": 0.8 },
        { "camera": "wide", "waitFor": { "selector": "[role=dialog]" }, "wait": 0.6 },
        { "click": { "selector": "input[aria-label='Email address']" }, "dur": 0.7 },
        { "type": "jordan.lee+demo@example.com", "cps": 22 },
        { "click": { "text": "Send invite" }, "dur": 0.7 },
        { "waitFor": { "selector": "[data-sonner-toast]" } },
        { "mark": "sent-toast", "target": { "selector": "[data-sonner-toast]" }, "look": false },
        { "wait": 1.8 },
        { "move": { "x": 900, "y": 640 }, "dur": 0.8 }
      ]
    }
  },
  "transition": "zoom-blur",
  "transitionSec": 0.5,
  "transitions": ["focus-pull", null, "push-through", null],
  "scenes": [
    { "type": "title", "text": "Invites now confirm", "subtitle": "ACME-101", "durationSec": 3.4 },
    {
      "type": "issue", "source": "Linear", "id": "ACME-101", "status": "Fixed in PR #101",
      "title": "I sent an invite but nothing told me it worked",
      "quote": "I clicked Send invite and the dialog just closed. Did it go out?",
      "reporter": "Reported by Riley · Oct 2",
      "durationSec": 7
    },
    {
      "type": "clip", "take": "before", "tag": "Before", "durationSec": 7,
      "autoCamera": true,
      "caption": "The dialog closes with no sign it worked"
    },
    {
      "type": "clip", "take": "after", "tag": "After", "durationSec": 7,
      "autoCamera": true,
      "caption": "A toast confirms the invite went out",
      "callouts": [{ "mark": "sent-toast", "label": "Invite sent" }]
    },
    {
      "type": "list", "title": "Shipped in PR #101", "durationSec": 5,
      "items": ["Toast after sending an invite", "Dialog stays until the request finishes"]
    }
  ]
}
